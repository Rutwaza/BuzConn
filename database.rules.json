{
  "rules": {
    ".write": false,
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state','lastChanged'])",
        "state": {
          ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')"
        },
        "lastChanged": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "typing": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $chatId.contains(auth.uid)",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    ".read": false
  }
}
