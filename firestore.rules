rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isPostOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---- Posts (Phase 1) ----------------------------------------------
    // Fields only the server (Cloud Functions) may change.
    function postServerFields() {
      return ['likes', 'comments', 'ownerId', 'likeCount', 'commentCount',
        'engagementMigrated', 'trendingScore', 'searchKeywords', 'hasVideo',
        'hashtags', 'boostUntil', 'boostedAt', 'boostPaymentId'];
    }

    // Only the current user's own id is added to or removed from `likes`
    // (used for likes on a comment). Nothing else changes.
    function isOwnLikeToggle() {
      let before = resource.data.get('likes', []).toSet();
      let after = request.resource.data.get('likes', []).toSet();
      let me = [request.auth.uid].toSet();
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && (
          (after.difference(before) == me && before.difference(after).size() == 0)
          || (before.difference(after) == me && after.difference(before).size() == 0)
        );
    }

    // A view/play counter going up by exactly one.
    function isCounterBump() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && changed.size() == 1
        && changed.hasOnly(['viewCount', 'playCount', 'shareCount'])
        && (
          (changed.hasAny(['viewCount'])
            && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1)
          || (changed.hasAny(['playCount'])
            && request.resource.data.playCount == resource.data.get('playCount', 0) + 1)
          || (changed.hasAny(['shareCount'])
            && request.resource.data.shareCount == resource.data.get('shareCount', 0) + 1)
        );
    }

    // Page owner/admin updates the page name/logo shown on the page's
    // posts (also posts made by team editors).
    function isPageBrandingEdit() {
      return resource.data.get('businessId', '') != ''
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['businessName', 'businessImageUrl'])
        && isPageManager(resource.data.businessId);
    }

    function isOwnerPostEdit() {
      return isPostOwner()
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(postServerFields());
    }

    function isChatParticipant(chatId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function canUpdateChatRequest() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['requestStatus', 'requesterId', 'requestRecipientId'])
        || (
          resource.data.get('requestStatus', 'none') == 'none'
          && resource.data.chatType == 'direct'
          && request.resource.data.requestStatus == 'pending'
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.requestRecipientId in resource.data.participants
          && request.resource.data.requestRecipientId != request.auth.uid
        )
        || (
          resource.data.requestStatus == 'pending'
          && resource.data.requestRecipientId == request.auth.uid
          && request.resource.data.requestStatus in ['accepted', 'rejected']
          && request.resource.data.requesterId == resource.data.requesterId
          && request.resource.data.requestRecipientId == resource.data.requestRecipientId
        );
    }

    function canCreateChatMessage(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return isChatParticipant(chatId)
        && chat.get('requestStatus', 'none') != 'rejected'
        && (chat.get('requestStatus', 'none') != 'pending'
          || chat.get('requesterId', '') == request.auth.uid)
        && (chat.get('chatType', '') == 'group'
          // Groups: "only admins can send" when an admin turned it on.
          ? (chat.get('onlyAdminsCanSend', false) != true
            || request.auth.uid in chat.get('admins', []))
          : !blockedByOtherParticipant(chat))
        // "system" messages are written by the server only.
        && request.resource.data.get('mediaType', '') != 'system';
    }

    // Group chats: members, admins, name, photo, settings and the invite
    // code only change through the groupAction function (functions/groups.js).
    function groupFieldsUnchanged() {
      return resource.data.get('chatType', '') != 'group'
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'chatType', 'admins', 'ownerId', 'createdBy', 'groupName', 'groupImageUrl',
          'groupDescription', 'onlyAdminsCanSend', 'onlyAdminsCanEditInfo',
          'inviteCode', 'memberCount', 'removedIds']);
    }

    // Moderation: if the other person blocked me, I cannot message them.
    function blockedByOtherParticipant(chat) {
      let others = chat.get('participants', []).removeAll([request.auth.uid]);
      return others.size() > 0
        && exists(/databases/$(database)/documents/users/$(others[0])/blocked/$(request.auth.uid));
    }

    // Admin = custom claim `admin: true` (functions/scripts/set-admin.js).
    // The email line is a temporary fallback until the claim is set; it only
    // works with a verified email. Delete it after running set-admin.js.
    function isSuperAdmin() {
      return isSignedIn()
        && (request.auth.token.get('admin', false) == true
          || (request.auth.token.get('email_verified', false) == true
            && request.auth.token.email == "nelsonjembe99@gmail.com"));
    }


    // Admin panel staff: admins, or moderators (claim set by adminSetRole).
    function isStaff() {
      return isSuperAdmin()
        || (isSignedIn() && request.auth.token.get('moderator', false) == true);
    }

    // ---- Users (Phase 1) ------------------------------------------------
    // Fields only the server/admin may set: account status, the unique
    // username (claimUsername function) and app access.
    function userServerFields() {
      return ['isActive', 'username', 'usernameLower', 'apps', 'admin', 'role',
        'searchKeywords', 'suspended', 'verified', 'verifiedAt', 'verifiedBy',
        'pageSlotsBought'];
    }

    // Posting "as a page": only your own page, and not while it's suspended.
    // ---- Pages and the page team (functions/pages.js) -------------------
    function pageData(bid) {
      return get(/databases/$(database)/documents/businesses/$(bid)).data;
    }
    // '' | 'editor' | 'admin' for the signed-in person on page `bid`.
    function pageRole(bid) {
      return pageData(bid).get('team', {}).get(request.auth.uid, '');
    }
    // Owner or team admin: edit the page, run the shop and orders.
    function isPageManager(bid) {
      return isSignedIn()
        && (pageData(bid).ownerId == request.auth.uid || pageRole(bid) == 'admin');
    }
    // Owner, admin or editor: post as the page.
    function isPageMember(bid) {
      return isSignedIn()
        && (pageData(bid).ownerId == request.auth.uid
          || pageRole(bid) in ['admin', 'editor']);
    }

    function canPostAsPage() {
      let bid = request.resource.data.get('businessId', '');
      return bid == null || bid == ''
        || (isPageMember(bid) && pageData(bid).get('suspended', false) != true);
    }

    // Shop catalog (products): the owner and team admins.
    function isBusinessOwner(businessId) {
      return isPageManager(businessId);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(userServerFields());
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(userServerFields());
      allow delete: if isOwner(userId);
    }

    // Private per-user data (device push tokens). Only the owner can see it.
    match /users_private/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Page fields only the server writes: search words, the verified
    // badge, the shop counter and the review average.
    function businessServerFields() {
      return ['searchKeywords', 'verified', 'verifiedAt', 'verifiedBy',
        'productCount', 'ratingAvg', 'ratingCount',
        'suspended', 'suspendedReason', 'suspendedAt',
        'ownerId', 'team', 'teamIds'];
    }

    match /businesses/{businessId} {
      allow read: if true;
      // New pages are made by the server (createPage): the first page is
      // free, more pages need a paid slot (functions/billing.js).
      allow create: if false;
      // searchKeywords are made by the server (functions/feed.js).
      // A page suspended by the team can't be edited until it's restored.
      // Owner or team admin. Hiding a page is fine; showing it again goes
      // through restorePage (it needs a free slot).
      allow update: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid
          || resource.data.get('team', {}).get(request.auth.uid, '') == 'admin')
        && resource.data.get('suspended', false) != true
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(businessServerFields())
        && !(resource.data.get('isActive', true) == false
          && request.resource.data.get('isActive', true) != false);
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Shop catalog: anyone can see it, only the business owner edits it.
    match /businesses/{businessId}/products/{productId} {
      allow read: if true;
      allow create, update: if isBusinessOwner(businessId)
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.get('suspended', false) != true
        // soldCount is counted by the server when orders are confirmed.
        && request.resource.data.get('soldCount', 0)
          == (resource == null ? 0 : resource.data.get('soldCount', 0))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.price <= 10000000;
      allow delete: if isBusinessOwner(businessId);
    }

    // "Get verified" requests: made by the server (requestVerification),
    // read by the person who asked and by the team.
    match /verification_requests/{requestId} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.requesterId == request.auth.uid);
      allow write: if false;
    }

    // Reviews: one per person (the id is their uid), 1-5 stars. The page
    // owner can't review their own page. The average is kept by the server.
    match /businesses/{businessId}/reviews/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId != uid
        && request.resource.data.keys().hasOnly(['rating', 'text', 'userName',
          'userImageUrl', 'createdAt', 'updatedAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.get('text', '') is string
        && request.resource.data.get('text', '').size() <= 500;
      allow delete: if isOwner(uid);
    }

    // Status (24h stories). Signed-in users can watch; you post and delete
    // only your own; it must expire within 24 hours.
    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.type in ['image', 'video', 'text']
        && request.resource.data.viewCount == 0
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(25, 'h')
        && request.resource.data.text.size() <= 300;
      allow update: if false; // viewCount is kept by the server
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // One view per person; only the status owner sees the list.
      match /views/{viewerId} {
        allow create: if isSignedIn() && viewerId == request.auth.uid
          && request.resource.data.viewerId == request.auth.uid;
        allow read: if isSignedIn() && (viewerId == request.auth.uid
          || get(/databases/$(database)/documents/statuses/$(statusId)).data.ownerId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // Orders are made by the server (createOrder) with the real prices.
    // Buyer: "I paid" or "Cancel". Shop owner: "Received" or "Not received".
    match /orders/{orderId} {
      // The admin team reads all orders (Orders tab, page details).
      allow read: if isStaff()
        || (isSignedIn()
          && (resource.data.buyerId == request.auth.uid
            || resource.data.businessOwnerId == request.auth.uid
            || request.auth.uid in resource.data.get('staffIds', [])));
      allow create, delete: if false;
      allow update: if isSignedIn() && (
        (resource.data.buyerId == request.auth.uid
          && resource.data.status in ['pending_payment', 'not_received']
          && request.resource.data.status in ['paid_claimed', 'cancelled']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'txRef', 'buyerNote', 'updatedAt', 'paidClaimedAt']))
        ||
        ((resource.data.businessOwnerId == request.auth.uid
            || request.auth.uid in resource.data.get('staffIds', []))
          && ((resource.data.status in ['pending_payment', 'paid_claimed', 'not_received']
                && request.resource.data.status == 'confirmed')
            || (resource.data.status == 'paid_claimed'
                && request.resource.data.status == 'not_received')
            // After payment: ready -> delivered (order tracking).
            || (resource.data.status == 'confirmed'
                && request.resource.data.status == 'ready')
            || (resource.data.status in ['confirmed', 'ready']
                && request.resource.data.status == 'delivered'))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'ownerNote', 'updatedAt', 'confirmedAt',
              'readyAt', 'deliveredAt']))
      );
    }

    // Payments to Duhuze (extra pages, boosts): made by the server only
    // (functions/billing.js). You see your own; the team sees all.
    match /payments/{paymentId} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Phase 3: each user's Following feed, filled by the server only.
    match /timelines/{userId}/items/{postId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Notifications are created only by Cloud Functions (functions/social.js).
    // The receiver can read them, mark them read/hidden, or delete them.
    match /notifications/{id} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.toUserId;
      allow create: if false;
      allow update: if isSignedIn() && request.auth.uid == resource.data.toUserId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readAt', 'hidden', 'hiddenAt', 'updatedAt']);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.toUserId;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.get('likes', []).size() == 0
        && request.resource.data.get('comments', []).size() == 0
        && request.resource.data.get('likeCount', 0) == 0
        && request.resource.data.get('commentCount', 0) == 0
        && !request.resource.data.keys().hasAny(['trendingScore', 'searchKeywords',
          'hashtags', 'boostUntil', 'boostedAt', 'boostPaymentId'])
        && canPostAsPage();
      // likeCount/commentCount are kept by Cloud Functions only.
      allow update: if isOwnerPostEdit() || isCounterBump() || isPageBrandingEdit();
      // The author, or the page owner/admin for posts made as the page.
      allow delete: if isPostOwner()
        || (resource.data.get('businessId', '') != ''
          && isPageManager(resource.data.businessId));

      // Phase 2: one document per like. The id is the user's id, so a user
      // can like a post only once.
      match /likes/{uid} {
        allow read: if true;
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
          && request.resource.data.userId == uid
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(uid);
      }

      // Phase 2: one document per comment.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly(['userId', 'userName',
            'userImageUrl', 'content', 'likes', 'createdAt', 'replyToUserId',
            'replyToUserName', 'replyToCommentId'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && request.resource.data.likes == []
          && request.resource.data.createdAt == request.time;
        // The author edits the text; anyone signed in likes/unlikes with
        // their own id only.
        allow update: if (
            isSignedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['content', 'editedAt'])
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 2000
          ) || isOwnLikeToggle();
        // The author, or the post owner (moderation), may delete.
        allow delete: if isSignedIn()
          && (resource.data.userId == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.ownerId
              == request.auth.uid);
      }
    }

    // "Posts I liked", so the app can colour the hearts. Owner only.
    // People I blocked (moderation.dart). Only I can see or change my list.
    match /users/{userId}/blocked/{otherId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Reports of posts, users, chats and statuses. Admins handle them.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.details.size() <= 500;
      // Staff read them in the Admin panel; changes go through adminResolveReport.
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // Copies of removed content, kept for the authorities (admin.js).
    match /evidence/{id} {
      allow read, write: if false;
    }

    // The admin team (written by the server: adminSetRole, set-admin.js).
    match /staff/{uid} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /users/{userId}/liked_posts/{postId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/favorites/{postId} {
      allow read, write: if isOwner(userId);
    }

    match /chats/{chatId} {
      // A chat that doesn't exist yet can be checked (nothing to leak), so
      // the app can tell "new chat" from "open the existing one".
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && (
          request.resource.data.chatType == 'direct'
          || (request.resource.data.chatType == 'business'
            && request.resource.data.clientId is string
            && request.resource.data.businessOwnerId is string
            && request.resource.data.businessId is string)
        );
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && canUpdateChatRequest()
        && groupFieldsUnchanged();

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        // You can only send as yourself.
        allow create: if canCreateChatMessage(chatId)
          && request.resource.data.senderId == request.auth.uid;
        // Only the sender edits or "unsends" their own message.
        allow update: if isChatParticipant(chatId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'editedAt', 'mediaUrl', 'mediaType', 'deleted', 'deletedAt',
              'location', 'liveUntil', 'liveEnded']);
        // Your own messages; ghost messages may also be removed by the
        // receiver after reading (that is how ghost mode works).
        allow delete: if isChatParticipant(chatId)
          && (resource.data.senderId == request.auth.uid
            || resource.data.get('isGhost', false) == true);
      }

      match /calls/{callId} {
        allow read, create, update, delete: if isChatParticipant(chatId);

        match /{subCollection}/{docId} {
          allow read, create, update, delete: if isChatParticipant(chatId);
        }
      }
    }

    match /user_follows/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.followerId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.followerId;
      allow update: if false;
    }

    match /page_follows/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.followerId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.followerId;
      allow update: if false;
    }

    // Admin activity log (written by Cloud Functions only).
    // Encrypted copies of ghost messages. Only Cloud Functions touch these.
    match /ghost_archive/{id} {
      allow read, write: if false;
    }

    match /admin_events/{eventId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }
  }
}
